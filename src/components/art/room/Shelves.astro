---
// Two wall shelves with books; they stand in for the bookshelf (education).
// The gap between them is tall enough for the trophy and its label.
// The picture frame at the right of the top shelf is its own drawing (Frame),
// and so is the trophy at the left of the bottom shelf (Trophy).
// Books carry .book so the room island can nudge them one by one; the last
// one on the top shelf (.tilt) tips over and rights itself when the shelves open.
---

<svg class="art" viewBox="1120 140 380 356" aria-hidden="true" focusable="false">
  <g filter="url(#wobble)">
    <polygon class="l f-paper" points="1120,250 1500,250 1500,262 1120,262" />
    <polyline class="l" points="1150,262 1150,290 1178,262" />
    <polyline class="l" points="1470,262 1470,290 1442,262" />
    <rect class="l f-accent book" x="1140" y="154" width="24" height="96" rx="2" />
    <rect class="l f-sky book" x="1166" y="166" width="20" height="84" rx="2" />
    <rect class="l f-yellow book" x="1188" y="146" width="26" height="104" rx="2" />
    <rect class="l f-sand book" x="1216" y="160" width="22" height="90" rx="2" />
    <rect class="l f-stone book" x="1240" y="152" width="24" height="98" rx="2" />
    <g class="book tilt">
      <rect class="l f-accent" x="1266" y="158" width="20" height="92" rx="2" />
    </g>

    <polygon class="l f-paper" points="1120,446 1500,446 1500,458 1120,458" />
    <polyline class="l" points="1150,458 1150,486 1178,458" />
    <polyline class="l" points="1470,458 1470,486 1442,458" />
    <rect class="l f-sand book" x="1300" y="346" width="26" height="100" rx="2" />
    <rect class="l f-sky book" x="1328" y="358" width="22" height="88" rx="2" />
    <rect class="l f-accent book" x="1352" y="338" width="24" height="108" rx="2" />
    <rect class="l f-yellow book" x="1378" y="354" width="20" height="92" rx="2" />
    <rect class="l f-stone book" x="1402" y="350" width="26" height="96" rx="2" />
  </g>
  <rect class="ring" x="1110" y="134" width="400" height="362" rx="10" />
</svg>
