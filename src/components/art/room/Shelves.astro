---
// Two wall shelves with books; they stand in for the bookshelf (education).
// Upright books carry .book so the room island can nudge them one by one.
---

<svg class="art" viewBox="1120 140 380 330" aria-hidden="true" focusable="false">
  <g filter="url(#wobble)">
    <polygon class="l f-paper" points="1120,250 1500,250 1500,262 1120,262" />
    <polyline class="l" points="1150,262 1150,290 1178,262" />
    <polyline class="l" points="1470,262 1470,290 1442,262" />
    <rect class="l f-accent book" x="1140" y="154" width="24" height="96" rx="2" />
    <rect class="l f-sky book" x="1166" y="166" width="20" height="84" rx="2" />
    <rect class="l f-yellow book" x="1188" y="146" width="26" height="104" rx="2" />
    <rect class="l f-sand book" x="1216" y="160" width="22" height="90" rx="2" />
    <rect class="l f-stone book" x="1240" y="152" width="24" height="98" rx="2" />
    <g class="book tilt">
      <rect class="l f-accent" x="1276" y="158" width="20" height="92" rx="2" transform="rotate(12 1286 250)" />
    </g>
    <rect class="l f-sky" x="1400" y="178" width="60" height="72" rx="2" />
    <circle class="l f-sand" cx="1430" cy="212" r="14" />

    <polygon class="l f-paper" points="1120,420 1500,420 1500,432 1120,432" />
    <polyline class="l" points="1150,432 1150,460 1178,432" />
    <polyline class="l" points="1470,432 1470,460 1442,432" />
    <rect class="l f-stone" x="1150" y="396" width="110" height="24" rx="2" />
    <rect class="l f-yellow" x="1158" y="374" width="92" height="22" rx="2" />
    <rect class="l f-sand book" x="1300" y="320" width="26" height="100" rx="2" />
    <rect class="l f-sky book" x="1328" y="332" width="22" height="88" rx="2" />
    <rect class="l f-accent book" x="1352" y="312" width="24" height="108" rx="2" />
    <rect class="l f-yellow book" x="1378" y="328" width="20" height="92" rx="2" />
    <rect class="l f-stone book" x="1402" y="324" width="26" height="96" rx="2" />
  </g>
  <rect class="ring" x="1110" y="134" width="400" height="336" rx="10" />
</svg>
