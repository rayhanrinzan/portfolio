---
// Laptop (projects). Two stacked drawings: the wobbly body, and on top the
// live parts (loss curve, loss number, cursor, keys) that the room island
// redraws as a real training run. Without JS the top one is a finished run.
---

<svg class="art" viewBox="380 470 420 246" aria-hidden="true" focusable="false">
  <g filter="url(#wobble)">
    <rect class="l f-paper" x="440" y="470" width="300" height="190" rx="8" />
    <rect class="l f-sky" x="452" y="482" width="276" height="166" rx="3" data-screen-rect />
    <polyline class="l" points="468,496 468,634 714,634" />
    <polygon class="l f-stone" points="415,668 765,668 800,716 380,716" />
    <line class="l" x1="560" y1="702" x2="620" y2="702" />
  </g>
  <path class="ring" d="M431,461 h318 v199 h22 l42,64 h-446 l42,-64 h22 z" />
</svg>
<svg class="art top" viewBox="380 470 420 246" aria-hidden="true" focusable="false">
  <g class="keys">
    {[452, 484, 516, 548, 580, 612, 644, 676, 708].map((x) => <line class="l key" x1={x} y1="683" x2={x + 18} y2="683" />)}
  </g>
  <polyline class="curve" data-curve points="478,506 508,560 552,594 602,611 656,620 708,624" />
  <text class="loss" x="706" y="510" text-anchor="end" data-loss>loss 0.02</text>
  <rect class="caret" x="710" y="497" width="2.5" height="15" />
</svg>
