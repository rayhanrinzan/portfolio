---
// Picture frame on the top shelf (gallery): a cat's face, drawn the way the
// rest of the room is. The lines inside are lighter so the doodle stays open
// when the frame is small.
---

<svg class="art" viewBox="1384 158 88 100" aria-hidden="true" focusable="false">
  <g class="frame-art">
    <g filter="url(#wobble)">
      <rect class="l f-sand" x="1392" y="166" width="72" height="84" rx="3" />
      <rect class="l f-paper" x="1401" y="175" width="54" height="66" rx="2" />
    </g>
    <path class="l f-yellow cat" d="M1411,203 l1,-15 l10,8 q6,-2 12,0 l10,-8 l1,15 q4,12 -4,21 q-13,8 -26,0 q-8,-9 -4,-21 z" />
    <path class="l cat" d="M1421,209 v3 M1435,209 v3 M1425,217 q3,3 6,0" />
    <path class="l cat" d="M1408,214 l-5,-1 M1408,219 l-5,2 M1448,214 l5,-1 M1448,219 l5,2" />
  </g>
  <rect class="ring" x="1386" y="160" width="84" height="96" rx="8" />
</svg>
