---
// Potted plant. Pot and leaves are separate drawings so the leaves can sway
// (and grow, when watered) without redrawing the pot.
---

<svg class="art top leaves" viewBox="190 530 115 225" aria-hidden="true" focusable="false">
  <!-- .grow scales about the point where the leaves meet, just inside the
       pot (246,664), so the plant stays rooted at every size -->
  <g class="grow">
    <g filter="url(#wobble)">
      <!-- new leaves, hidden until the plant has been watered (water.ts) -->
      <g class="sprout"><ellipse class="l f-sage" cx="221" cy="653" rx="10" ry="27" transform="rotate(-66 221 653)" /></g>
      <g class="sprout"><ellipse class="l f-sage" cx="270" cy="652" rx="10" ry="27" transform="rotate(64 270 652)" /></g>
      <ellipse class="l f-sage" cx="222" cy="630" rx="15" ry="42" transform="rotate(-28 222 630)" />
      <ellipse class="l f-sage" cx="270" cy="622" rx="15" ry="44" transform="rotate(22 270 622)" />
      <ellipse class="l f-sage" cx="246" cy="604" rx="14" ry="42" />
    </g>
  </g>
</svg>
<svg class="art top" viewBox="190 530 115 225" aria-hidden="true" focusable="false">
  <g filter="url(#wobble)">
    <polygon class="l f-sand" points="200,660 292,660 280,750 212,750" />
  </g>
</svg>
