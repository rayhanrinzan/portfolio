---
// Lamp light at night: a flat pale-yellow cone, never a blur. Landscape is
// one shape. Portrait is two (the wall part sits behind the shelves, the
// table part on top of the table) so the light never tints the wall objects.
interface Props {
  variant: 'land' | 'port-wall' | 'port-table';
}

const { variant } = Astro.props;
---

{
  variant === 'land' ? (
    <svg class="art" viewBox="690 380 640 440" aria-hidden="true" focusable="false">
      <polygon class="glow" points="950,380 1050,380 1330,820 690,820" />
    </svg>
  ) : (
    <svg class="art" viewBox="0 398 800 1082" aria-hidden="true" focusable="false">
      {variant === 'port-wall' ? (
        <polygon class="glow" points="602,398 722,398 760,1135 420,1135" />
      ) : (
        <polygon class="glow" points="420,1135 760,1135 806,1480 328,1480" />
      )}
    </svg>
  )
}
