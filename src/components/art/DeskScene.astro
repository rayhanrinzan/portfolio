---
// The room in miniature for the list view header: the same drawings and the
// same landscape positions as the room view, with nothing to click. Static
// apart from CSS-only mug steam, which is off under prefers-reduced-motion.
import '../room/room.css';
import Corkboard from './room/Corkboard.astro';
import Window from './room/Window.astro';
import Shelves from './room/Shelves.astro';
import Frame from './room/Frame.astro';
import Trophy from './room/Trophy.astro';
import Lamp from './room/Lamp.astro';
import Glow from './room/Glow.astro';
import Table from './room/Table.astro';
import Plant from './room/Plant.astro';
import Laptop from './room/Laptop.astro';
import Mug from './room/Mug.astro';
import Mail from './room/Mail.astro';
---

<div
  class="scene"
  role="img"
  aria-label="A room with a wide table holding a laptop that shows a falling loss curve, a steaming mug, a plant, an envelope and a phone; a corkboard, a window, a pendant lamp and two bookshelves with a framed picture of a cat and a trophy on the wall behind"
>
  <div class="scene-stage">
    <div class="obj deco obj-corkboard" data-layer="wall"><Corkboard /></div>
    <div class="obj deco obj-window" data-layer="wall"><Window clipId="scene-pane" /></div>
    <div class="obj deco obj-shelves" data-layer="wall"><Shelves /></div>
    <div class="obj deco obj-frame" data-layer="wall"><Frame /></div>
    <div class="obj deco obj-trophy" data-layer="wall"><Trophy /></div>
    <div class="obj deco obj-lamp" data-layer="wall"><Lamp /></div>
    <div class="obj deco obj-table-land" data-layer="furniture"><Table variant="land" /></div>
    <div class="obj deco obj-glow obj-glow-land" data-layer="glow"><Glow variant="land" /></div>
    <div class="obj deco obj-plant" data-layer="objects"><Plant /></div>
    <div class="obj deco obj-laptop" data-layer="objects"><Laptop /></div>
    <div class="obj deco obj-mug" data-layer="objects"><Mug /></div>
    <div class="obj deco obj-mail" data-layer="objects"><Mail /></div>
  </div>
</div>

<style>
  .scene { container-type: inline-size; }
  .scene-stage {
    --u: calc(100cqw / 1600);
    position: relative;
    height: calc(900 * var(--u));
    overflow: hidden;
  }
  /* lighter line at this size so the small drawings stay open */
  .scene :global(.l) { stroke-width: 1.6; }
  .scene :global(.curve) { stroke-width: 2; }
  .scene :global(.steam) { animation: steam 3.2s ease-in-out infinite backwards; }
  .scene :global(.steam + .steam) { animation-delay: 1.4s; }

  @keyframes steam {
    0% { opacity: 0; transform: translateY(6px); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene :global(.steam) { animation: none; opacity: 0.8; }
  }
</style>
