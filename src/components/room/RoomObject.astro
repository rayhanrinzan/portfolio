---
// One clickable thing in the room: a real button wrapped around its drawing.
interface Props {
  id: string;
  /** Accessible name, e.g. "Open projects (laptop)". */
  name: string;
  /** Handwritten label; names only the destination. */
  label?: string;
  /** Section this opens: on a notebook page, or on the laptop screen for projects. */
  target?: string;
  layer: 'wall' | 'objects';
  /** Order in the drop-in entrance. */
  drop: number;
}

const { id, name, label, target, layer, drop } = Astro.props;
---

<button
  type="button"
  class:list={['obj', `obj-${id}`]}
  data-obj={id}
  data-layer={layer}
  data-drop={drop}
  data-target={target}
  aria-label={name}
>
  <slot />
  {label && <span class="lab" aria-hidden="true">{label}</span>}
</button>
