---
import '@fontsource/klee-one/latin-600.css';
import '@fontsource/zen-maru-gothic/latin-400.css';
import '@fontsource/zen-maru-gothic/latin-500.css';
import '@fontsource/zen-maru-gothic/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#E4F2FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C2733" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <!-- og:image and twitter:image arrive with the share image in Phase 5 -->

    <!-- Before first paint: pick the sky from local time and show the room.
         Without JS none of this runs and the page is the plain list view. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var h = new Date().getHours();
        var sky = h < 5 || h >= 20 ? 'night' : h < 11 ? 'morning' : h < 17 ? 'afternoon' : 'golden';
        var asked = new URLSearchParams(location.search).get('sky');
        if (['morning', 'afternoon', 'golden', 'night'].indexOf(asked) > -1) sky = asked;
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) sky = 'night';
        d.dataset.sky = sky;
        d.dataset.theme = sky === 'night' ? 'night' : 'light';
        d.dataset.view = location.hash.length > 1 ? 'list' : 'room';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
