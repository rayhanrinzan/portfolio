---
import '@fontsource/klee-one/latin-600.css';
import '@fontsource/zen-maru-gothic/latin-400.css';
import '@fontsource/zen-maru-gothic/latin-500.css';
import '@fontsource/zen-maru-gothic/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// The share image is the room itself, 1200×630. Its URL is absolute once
// `site` is set in astro.config.mjs (Phase 6); until then it is root-relative.
const shareImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const shareAlt = `${title}'s portfolio: a hand-drawn room with a laptop, a corkboard, bookshelves and a window.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#E4F2FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C2733" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />

    <!-- Before first paint: pick the sky, show the room (or the list, if that
         is what this visitor chose last time), and hold the table's things in
         the air for the entrance. When the entrance plays the room opens in
         daylight and the lamp brings the night; otherwise the sky follows
         local time.
         Without JS none of this runs and the page is the plain list view. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var h = new Date().getHours();
        // daytime is always the blue afternoon sky; ?sky= forces day or night
        var day = 'afternoon';
        var skies = [day, 'night'];
        var sky = h < 5 || h >= 20 ? 'night' : day;
        var asked = new URLSearchParams(location.search).get('sky');
        if (skies.indexOf(asked) > -1) sky = asked;
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) sky = 'night';
        else asked = null;
        var view = 'room';
        try {
          if (localStorage.getItem('view') === 'list') view = 'list';
        } catch (e) {}
        d.dataset.view = view;
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (view === 'room' && !still && location.hash.length < 2) {
          d.dataset.enter = '';
          // the entrance opens in daylight and ends with the lamp coming on,
          // unless a sky was asked for in the URL
          if (skies.indexOf(asked) < 0) {
            sky = day;
            d.dataset.dusk = '';
          }
        }
        d.dataset.sky = sky;
        d.dataset.theme = sky === 'night' ? 'night' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
